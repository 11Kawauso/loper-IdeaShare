rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* アイデア投稿。
       閲覧は誰でも可能（ログインしていなくても読める）。
       作成は本人のUIDで、削除は投稿者本人のみ。
       更新は「反応（いいね・完成・開発中）の付け外し」だけを許可し、
       本文や投稿者の書き換えはできない。 */
    match /ideas/{ideaId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && isValidIdea()
        // 投稿日時はサーバー側の時刻に固定する。
        // クライアントが未来の日時を指定して一覧の先頭に居座るのを防ぐ。
        && request.resource.data.createdAt == request.time
        // 作成時点では誰も反応していない
        && request.resource.data.likeBy.size() == 0
        && request.resource.data.doneBy.size() == 0
        && request.resource.data.devBy.size() == 0;

      allow update: if isValidReactionToggle();

      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;

      function isSignedIn() {
        return request.auth != null;
      }

      /* 保存される投稿の各項目が、画面の入力制限と同じ範囲に収まっているか検証する。
         クライアントを改造して巨大なデータや不正な値を送られるのを防ぐ。 */
      function isValidIdea() {
        let d = request.resource.data;
        return d.authorUid is string
          && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 20
          && d.authorColor is string && d.authorColor.size() <= 20
          // アイコン画像はデータURLの文字列として持つ（未設定なら空文字）
          && d.authorAvatar is string && d.authorAvatar.size() <= 200000
          && d.text is string && d.text.size() > 0 && d.text.size() <= 300
          && d.likeBy is list && d.doneBy is list && d.devBy is list
          && d.keys().hasOnly(['authorUid', 'authorName', 'authorColor', 'authorAvatar',
                               'text', 'createdAt', 'likeBy', 'doneBy', 'devBy']);
      }

      /* 反応の更新。変更してよいのは3つの配列だけで、
         それぞれ「自分のUIDを1つ足す」か「1つ外す」しかできない。
         他人のUIDを勝手に足したり、数を水増ししたりはできない。 */
      function isValidReactionToggle() {
        let d = request.resource.data;
        let p = resource.data;
        return isSignedIn()
          // 自分の投稿には反応できない
          && p.authorUid != request.auth.uid
          && d.diff(p).affectedKeys().hasOnly(['likeBy', 'doneBy', 'devBy'])
          && toggledByMe(p.likeBy, d.likeBy)
          && toggledByMe(p.doneBy, d.doneBy)
          && toggledByMe(p.devBy,  d.devBy)
          // 「完成」と「開発中」は同時に立てられない
          && !(d.doneBy.hasAny([request.auth.uid]) && d.devBy.hasAny([request.auth.uid]));
      }

      /* 配列の変化が「変化なし」「自分のUIDが1つ増えた」
         「自分のUIDが1つ減った」のいずれかであることを確認する。 */
      function toggledByMe(oldArr, newArr) {
        return newArr == oldArr
          || (newArr.size() == oldArr.size() + 1
              && newArr.hasAll(oldArr)
              && newArr.hasOnly(oldArr.concat([request.auth.uid])))
          || (oldArr.size() == newArr.size() + 1
              && oldArr.hasAll(newArr)
              && oldArr.hasOnly(newArr.concat([request.auth.uid])));
      }
    }

    /* 通知。他人のアイデアに「いいね」「完成」を押したとき、
       押した人が投稿者あての通知を作る。

       ドキュメントIDを「アイデアID_押した人のUID_種類」に固定することで、
       同じ人が同じ反応を付け外ししても通知が増えないようにしている。

       閲覧・既読・削除は受け取った本人のみ。 */
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.toUid == request.auth.uid;

      /* 押した人が作る（付け直したときは上書きになる） */
      allow create, update: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        // 自分あての通知は作れない
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.kind in ['like', 'done']
        // IDと中身がずれていると重複を防げなくなるため、必ず対応させる
        && notifId == request.resource.data.ideaId + '_' + request.auth.uid + '_' + request.resource.data.kind
        && request.resource.data.ideaId is string
        && request.resource.data.ideaText is string && request.resource.data.ideaText.size() <= 300
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 20
        && request.resource.data.fromColor is string && request.resource.data.fromColor.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false
        && request.resource.data.keys().hasOnly(['toUid', 'fromUid', 'fromName', 'fromColor',
                                                 'kind', 'ideaId', 'ideaText', 'createdAt', 'read'])
        // 宛先が本当にそのアイデアの投稿者かを確認する。
        // 無関係な相手に通知を送りつけられるのを防ぐ。
        && get(/databases/$(database)/documents/ideas/$(request.resource.data.ideaId)).data.authorUid
             == request.resource.data.toUid;

      /* 受け取った本人が既読にする */
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;

      allow delete: if request.auth != null && resource.data.toUid == request.auth.uid;
    }

    /* 通報。ログインユーザーが自分のUIDで作成のみ可能。
       閲覧・更新・削除はクライアントから行わない
       （Firebaseコンソールから運営が確認する）。 */
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.ideaId is string
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }
  }
}
